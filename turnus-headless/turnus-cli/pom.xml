<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.turnus</groupId>
        <artifactId>turnus-headless</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>turnus-cli</artifactId>
    <packaging>jar</packaging>
    <name>Turnus CLI</name>
    <description>Command-line interface for Turnus analysis tools</description>

    <dependencies>
        <!-- Internal dependencies -->
        <dependency>
            <groupId>co.turnus</groupId>
            <artifactId>turnus-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.turnus</groupId>
            <artifactId>turnus-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.turnus</groupId>
            <artifactId>turnus-analysis</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- CLI Framework -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- Logging backend (SLF4J provider) for the CLI executable jar -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Create executable JAR with all dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>turnus.cli.TurnusCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>

                                        <!-- Avoid JPMS metadata warnings in uber-jars -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>

                                        <!-- Avoid noisy resource overlap warnings (uber-jar has its own manifest) -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>

                                        <!-- Eclipse/EMF metadata not needed for headless CLI runtime -->
                                        <exclude>about.html</exclude>
                                        <exclude>plugin.xml</exclude>
                                        <exclude>plugin.properties</exclude>
                                        <exclude>about.ini</exclude>
                                        <exclude>about.mappings</exclude>
                                        <exclude>about.properties</exclude>
                                        <exclude>modeling32.png</exclude>
                                    </excludes>
                                </filter>

                                <!--
                                  De-duplicate classes at shade time only.
                                  (We keep the module jars intact so compilation stays correct.)
                                -->
                                <filter>
                                    <artifact>co.turnus:turnus-analysis</artifact>
                                    <excludes>
                                        <exclude>turnus/model/trace/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>co.turnus:turnus-common-api</artifact>
                                    <excludes>
                                        <exclude>turnus/common/TurnusException*.class</exclude>
                                        <exclude>turnus/common/TurnusRuntimeException*.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
